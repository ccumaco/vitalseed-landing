---
interface Props {
  claro?: boolean;
  class?: string;
}
const { claro = false, class: clase = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 font-titulo text-xl font-bold tracking-tight', clase]}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" class="shrink-0">
    <circle cx="16" cy="16" r="15" fill={claro ? '#9bd63b' : '#17422f'} />
    <path
      d="M16 25c-.4-5.4 1.4-9.4 5.6-12.6-4.8.4-8.1 3.3-9.1 7.9C11.6 17 10.2 12.8 11.4 8c3.9 3 5.7 7.2 4.6 12.2"
      fill="none"
      stroke={claro ? '#0f2d21' : '#f6f8f2'}
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class={claro ? 'text-papel' : 'text-hoja-900'}>Vital<span class={claro ? 'text-lima-500' : 'text-hoja-500'}>Seed</span></span>
</span>
